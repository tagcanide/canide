# Copie para .env.local (fora do Git) e preencha com o app web do projeto Firebase EXCLUSIVO do controle remoto.
# Não use o projeto Firebase do sistema CANIDÉ. Estes valores identificam o projeto e não dão privilégio;
# a proteção das sessões está em database.rules.json. Nunca coloque aqui chaves de conta de serviço.
VITE_SITE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# 1 = usar o Firebase Emulator local (só para testes)
VITE_FIREBASE_EMULADOR=
